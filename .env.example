# Neon pooled connection
DATABASE_URL='postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require'
# Direct Neon connection for migrations
DATABASE_URL_UNPOOLED='postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require'

ADMIN_EMAIL='admin@example.com'
# Generate with: pnpm hash-password (enter the password, then press Ctrl+Z and Enter)
ADMIN_PASSWORD_HASH=scrypt:32768:8:1:...
# At least 32 random characters
AUTH_SECRET='replace-with-at-least-32-random-characters'

# 32 random bytes encoded as base64; for example: openssl rand -base64 32
APP_ENCRYPTION_KEY='replace-with-base64-encoded-32-bytes'

# Local Inngest development. Leave the event and signing keys unset.
INNGEST_DEV=1
